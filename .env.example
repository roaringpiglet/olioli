# ---- Supabase ----
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# Optional — override the default model
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Manager approval emails ----
# If RESEND_API_KEY is empty, approval links are logged to the server console
# so you can still approve users during local dev without setting up Resend.
RESEND_API_KEY=
# Where approval emails get sent (the "manager" — you)
MANAGER_EMAIL=you@example.com
# Verified sender on Resend (or use "onboarding@resend.dev" for testing)
FROM_EMAIL=onboarding@resend.dev

# ---- App ----
# Used to build approval links in emails. Set to your deployed URL in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any long random string — used to sign approval tokens.
APPROVAL_SECRET=change-me-to-a-long-random-string
